APP_NAME=SantéConnect
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production
APP_DEBUG=true
# Production: APP_DEBUG=false
APP_URL=http://localhost
# Production: APP_URL=https://your-real-domain.example

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production recommended: LOG_CHANNEL=daily
# LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=error

# --- Database ---
# Tests use SQLite :memory: via phpunit.xml.
# Local/production target: MariaDB 10.4+ or MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medical_booking
DB_USERNAME=root
DB_PASSWORD=
# Never run migrate:fresh / db:wipe / migrate:refresh on shared or production data.
# Production migrate: php artisan migrate --force

# --- Session / cache / queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Notifications are currently synchronous (not ShouldQueue).
# Keep a worker only if you add queued jobs later:
# php artisan queue:work

CACHE_STORE=database

# --- Mail ---
# Local: log. Production: real SMTP/API provider. Do not commit credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
